{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm ci)",
      "Bash(node scripts/run_ci_tests.mjs)",
      "Bash(node tests/*)",
      "Bash(node --experimental-strip-types tests/*)",
      "Bash(bash tests/test_pages_secret_guard.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git config *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "Bash(rm *)",
      "Bash(npm install *)",
      "Bash(npm run dev*)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/database/**)",
      "Edit(/wrangler.toml)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/scripts/run_ci_tests.mjs)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * *:main)",
      "Bash(git push * +*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete *)",
      "Bash(git push * --mirror*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(npm run deploy*)",
      "Bash(npm run tail*)",
      "Bash(npm publish*)",
      "Read(~/.supabase/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pgpass)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.production)",
      "Read(~/**/.dev.vars)",
      "Read(~/**/*.pem)",
      "Read(~/**/*.key)",
      "WebFetch(domain:api.supabase.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:api.cloudflare.com)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["git *", "gh *", "docker *"],
    "filesystem": {
      "denyRead": [
        "~/.supabase",
        "~/.config/.wrangler",
        "~/.config/gh",
        "~/.aws",
        "~/.ssh",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.pgpass",
        "~/.netrc",
        "~/.git-credentials",
        "~/.claude/.credentials.json",
        "~/**/.env",
        "~/**/.env.local",
        "~/**/.env.production",
        "~/**/.dev.vars"
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    }
  }
}
