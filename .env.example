# =============================================================================
#  ALPHA-XAU — .env.example
#
#  NOMS DE VARIABLES UNIQUEMENT. Aucune valeur réelle ne doit être committée.
#  En production, ces variables sont posées via `wrangler secret put`.
#  Ce fichier ne sert qu'au développement local et à la documentation.
# =============================================================================

# --- Base de données (backend uniquement) ------------------------------------
SUPABASE_URL=
# Clé service_role : BYPASSRLS. Ne doit JAMAIS atteindre le frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Moteur IA ---------------------------------------------------------------
ANTHROPIC_API_KEY=
COMMITTEE_TOKEN=

# --- Moteur news -------------------------------------------------------------
INGEST_TOKEN=
NEWSAPI_KEY=
GDELT_TIMESPAN=60min

# --- Canal event-driven : news -> comité -------------------------------------
# XAU-V2-OPS-010 : appel direct in-process (handleCommitteeEvent), plus de
# transport HTTP self-fetch. Ce chemin ne dépend d'aucune variable
# supplémentaire : ANTHROPIC_API_KEY (ci-dessus) suffit, et COMMITTEE_TOKEN
# ne le concerne pas — ce jeton ne protège que la surface HTTP externe
# /committee (déclenchement manuel/ops), pas ce chemin interne.

# --- Moteur marché -----------------------------------------------------------
# FRED : US10Y (DGS10), Real Yield (DFII10), VIX (VIXCLS), WTI (DCOILWTICO)
FRED_API_KEY=
# Twelve Data : DXY. Sans cette clé, le DXY est marqué UNAVAILABLE.
# Aucune substitution par un autre indice dollar n'est effectuée.
TWELVE_DATA_KEY=
# Stooq (XAUUSD) ne requiert aucune clé.

# --- Divers ------------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
#  FRONTEND — variables PUBLIQUES, injectées au déploiement GitHub Pages via
#  des GitHub *Variables* (Settings > Variables), jamais des Secrets.
#  La clé anon est publique par conception et bornée par les policies RLS.
#
#    ALPHA_XAU_SUPABASE_URL
#    ALPHA_XAU_SUPABASE_ANON_KEY
# =============================================================================
