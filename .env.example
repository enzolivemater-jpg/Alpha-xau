# =============================================================================
#  ALPHA-XAU — .env.example
#
#  NOMS DE VARIABLES UNIQUEMENT. Aucune valeur réelle ne doit être committée.
#  En production, ces variables sont posées via `wrangler secret put`.
#  Ce fichier ne sert qu'au développement local et à la documentation.
# =============================================================================

# --- Base de données (backend uniquement) ------------------------------------
SUPABASE_URL=
# Clé service_role : BYPASSRLS. Ne doit JAMAIS atteindre le frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Moteur IA ---------------------------------------------------------------
ANTHROPIC_API_KEY=
COMMITTEE_TOKEN=

# --- Moteur news -------------------------------------------------------------
INGEST_TOKEN=
NEWSAPI_KEY=
GDELT_TIMESPAN=60min

# --- Canal event-driven : news -> comité -------------------------------------
# AI_ENGINE_URL est l'URL DU WORKER LUI-MÊME, suffixée de /committee :
#     https://alpha-xau.<sous-domaine>.workers.dev/committee
# Elle n'est donc connue qu'APRÈS le premier déploiement : le staging se fait
# en DEUX passes (procédure détaillée dans wrangler.toml).
AI_ENGINE_URL=

# =============================================================================
#  COUPLAGE OBLIGATOIRE : AI_ENGINE_TOKEN == COMMITTEE_TOKEN
#
#  Le news_engine émet : Authorization: Bearer <AI_ENGINE_TOKEN>
#  Le comité compare à : COMMITTEE_TOKEN (comparaison à temps constant)
#
#  Deux valeurs différentes produisent un 401 sur CHAQUE notification. Rien
#  d'autre ne casse : les crons tournent, le terminal reste alimenté, et la
#  réaction temps réel aux CATALYST disparaît en silence. Ces deux secrets
#  portent la même valeur volontairement — ce sont les deux extrémités du
#  même canal, pas deux secrets indépendants.
# =============================================================================
AI_ENGINE_TOKEN=

# --- Moteur marché -----------------------------------------------------------
# FRED : US10Y (DGS10), Real Yield (DFII10), VIX (VIXCLS), WTI (DCOILWTICO)
FRED_API_KEY=
# Twelve Data : DXY. Sans cette clé, le DXY est marqué UNAVAILABLE.
# Aucune substitution par un autre indice dollar n'est effectuée.
TWELVE_DATA_KEY=
# Stooq (XAUUSD) ne requiert aucune clé.

# --- Divers ------------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
#  FRONTEND — variables PUBLIQUES, injectées au déploiement GitHub Pages via
#  des GitHub *Variables* (Settings > Variables), jamais des Secrets.
#  La clé anon est publique par conception et bornée par les policies RLS.
#
#    ALPHA_XAU_SUPABASE_URL
#    ALPHA_XAU_SUPABASE_ANON_KEY
# =============================================================================
